#!/bin/bash
# shellcheck disable=SC2015  # `A && B || C` is used where B cannot fail
# avdslim - clone, boot and delete Android emulators (AVDs) copy-on-write.
# Single file, bash 3.2 compatible, depends only on the Android SDK tools and macOS builtins.
# Run `avdslim --help` for the full reference.

set -u
set -o pipefail

AVDSLIM_VERSION="0.1.0"
PORT_MIN=5554
PORT_MAX=5584

# ---------------------------------------------------------------- output helpers

die() { echo "avdslim: $*" >&2; exit 1; }
usage_die() { echo "avdslim: $*" >&2; echo "Try 'avdslim --help'." >&2; exit 2; }
refuse() { echo "avdslim: refused: $*" >&2; exit 3; }
warn() { echo "avdslim: warning: $*" >&2; }
note() { echo "avdslim: $*" >&2; }

# ---------------------------------------------------------------- environment

SDK_ROOT="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-$HOME/Library/Android/sdk}}"
AVD_HOME="${ANDROID_AVD_HOME:-${ANDROID_USER_HOME:-$HOME/.android}/avd}"
STATE_DIR="${AVDSLIM_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/avdslim}"

find_tool() { # name sdk-subdir -> path on stdout, empty if missing
  if [ -x "$SDK_ROOT/$2/$1" ]; then echo "$SDK_ROOT/$2/$1"; else command -v "$1" 2>/dev/null || true; fi
}
need_adb() { ADB="$(find_tool adb platform-tools)"; [ -n "$ADB" ] || die "adb not found (set ANDROID_SDK_ROOT)"; }
need_emulator() { EMULATOR="$(find_tool emulator emulator)"; [ -n "$EMULATOR" ] || die "emulator not found (set ANDROID_SDK_ROOT)"; }

now_ms() { perl -MTime::HiRes=time -e 'printf "%d", time*1000' 2>/dev/null || echo "$(date +%s)000"; }
fmt_secs() { awk -v ms="$1" 'BEGIN { printf "%.1fs", ms/1000 }'; }

# ---------------------------------------------------------------- options (parsed from anywhere)

JSON=0; DRY=0; GOLDEN_OK=0; FORCE=0; BOOTED_ONLY=0; WINDOW=0; COLD=0; STOP=0; NO_ANIM=0
OPT_PORT=""; OPT_TIMEOUT=180; OPT_RAM=""; OPT_CORES=""
POS=()

parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) JSON=1 ;;
      -n|--dry-run) DRY=1 ;;
      --golden) GOLDEN_OK=1 ;;
      --force) FORCE=1 ;;
      --booted) BOOTED_ONLY=1 ;;
      --window) WINDOW=1 ;;
      --cold) COLD=1 ;;
      --stop) STOP=1 ;;
      --no-animations) NO_ANIM=1 ;;
      -h|--help) cmd_help; exit 0 ;;
      --port|--timeout|--ram|--cores)
        [ $# -ge 2 ] || usage_die "$1 needs a value"
        set_value_opt "$1" "$2"; shift ;;
      --port=*|--timeout=*|--ram=*|--cores=*) set_value_opt "${1%%=*}" "${1#*=}" ;;
      --) shift; while [ $# -gt 0 ]; do POS+=("$1"); shift; done; break ;;
      -*) usage_die "unknown option: $1" ;;
      *) POS+=("$1") ;;
    esac
    shift
  done
}

set_value_opt() {
  case "$2" in ''|*[!0-9]*) usage_die "$1 needs a positive integer, got '$2'" ;; esac
  case "$1" in
    --port) OPT_PORT="$2" ;;
    --timeout) OPT_TIMEOUT="$2" ;;
    --ram) OPT_RAM="$2" ;;
    --cores) OPT_CORES="$2" ;;
  esac
}

# Run a mutating command, or print it under --dry-run.
act() {
  if [ "$DRY" = 1 ]; then echo "+ $*"; return 0; fi
  "$@"
}

# ---------------------------------------------------------------- names, ini files, paths

sanitize_name() {
  printf '%s' "$1" | sed -e 's/[[:space:]][[:space:]]*/-/g' -e 's/[^A-Za-z0-9._-]/_/g'
}

valid_name() {
  local re='^[A-Za-z0-9][A-Za-z0-9._-]*$'
  [ "${#1}" -le 64 ] && [[ $1 =~ $re ]]
}

ini_get() { # file key
  awk -F= -v k="$2" '$1 == k { print substr($0, length(k) + 2); exit }' "$1" 2>/dev/null
}

# Set key=value in an ini file (replace in place, append if absent).
ini_set() { # file key value
  local f="$1" k="$2" v="$3" tmp
  tmp="$f.avdslim.$$"
  if grep -q "^$(printf '%s' "$k" | sed 's/[.]/\\./g')=" "$f" 2>/dev/null; then
    awk -F= -v k="$k" -v v="$v" '$1 == k { print k "=" v; next } { print }' "$f" > "$tmp"
  else
    { cat "$f"; echo "$k=$v"; } > "$tmp"
  fi
  mv "$tmp" "$f"
}

# Only ever touch directories directly under the AVD home with the expected name.
safe_avd_dir() { # name dir -> ok if dir is exactly $AVD_HOME/<name>.avd, a real dir, no symlink
  local home real
  home="$(cd "$AVD_HOME" 2>/dev/null && pwd -P)" || return 1
  [ -d "$2" ] && [ ! -L "$2" ] && [ -f "$2/config.ini" ] || return 1
  real="$(cd "$2" 2>/dev/null && pwd -P)" || return 1
  [ "$real" = "$home/$1.avd" ]
}

# Resolve an AVD by name -> AVD_DIR, AVD_INI. Dies if missing.
require_avd() {
  local name="$1" p
  valid_name "$name" || usage_die "invalid AVD name '$name' (letters, digits, . _ - only)"
  AVD_INI="$AVD_HOME/$name.ini"
  [ -f "$AVD_INI" ] || die "no such AVD '$name' (see: avdslim list)"
  p="$(ini_get "$AVD_INI" path)"
  [ -n "$p" ] || p="$AVD_HOME/$name.avd"
  [ -d "$p" ] && [ -f "$p/config.ini" ] || die "AVD '$name' is broken: $p has no config.ini"
  AVD_DIR="$p"
}

is_golden() { [ -f "$1/avdslim.golden" ]; }
is_managed() { [ -f "$1/avdslim.managed" ]; }

kind_of() { # dir
  if is_golden "$1"; then echo golden; elif is_managed "$1"; then echo clone; else echo avd; fi
}

need_golden_flag() { # name dir what
  if is_golden "$2" && [ "$GOLDEN_OK" != 1 ]; then
    refuse "'$1' is a golden AVD; $3 needs --golden (golden AVDs are only for refreshing)"
  fi
}

# ---------------------------------------------------------------- running emulators

ps_snapshot() { PS_SNAP="$(ps -axo pid=,command= 2>/dev/null)"; }

# find_running name -> sets R_PIDS (space separated) and R_PORT; returns 0 when running.
find_running() {
  [ -n "${PS_SNAP+x}" ] || ps_snapshot
  local out
  out="$(printf '%s\n' "$PS_SNAP" | awk -v n="$1" '
    index($0, "qemu-system") || index($0, "/emulator") {
      hit = 0; port = ""
      for (i = 2; i <= NF; i++) {
        if ($i == "-avd" && $(i + 1) == n) hit = 1
        if ($i == "-port") port = $(i + 1)
      }
      if (hit) { pids = pids " " $1; if (port != "") p = port }
    }
    END { if (pids != "") print p "|" pids }')"
  [ -n "$out" ] || { R_PIDS=""; R_PORT=""; return 1; }
  R_PORT="${out%%|*}"
  R_PIDS="${out#*|}"
  if [ -z "$R_PORT" ]; then # started without -port (e.g. Android Studio): ask adb
    R_PORT="$(port_via_adb "$1")"
  fi
  return 0
}

port_via_adb() {
  local adb s
  adb="$(find_tool adb platform-tools)"
  [ -n "$adb" ] || return 0
  for s in $("$adb" devices 2>/dev/null | awk '/^emulator-[0-9]+[[:space:]]+device/ { print $1 }'); do
    if [ "$("$adb" -s "$s" emu avd name 2>/dev/null | head -1 | tr -d '\r')" = "$1" ]; then
      echo "${s#emulator-}"; return 0
    fi
  done
}

serial_of() { [ -n "$R_PORT" ] && echo "emulator-$R_PORT"; }

port_in_use() { # port, using USED_PORTS snapshot
  case " $USED_PORTS " in *" $1 "*|*" $(($1 + 1)) "*) return 0 ;; esac
  return 1
}

pick_port() {
  mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
  local adb p lock pid
  adb="$(find_tool adb platform-tools)"
  USED_PORTS="$( {
    lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | awk 'NR > 1 { n = split($9, a, ":"); print a[n] }'
    [ -n "$adb" ] && "$adb" devices 2>/dev/null | awk -F'[- \t]' '/^emulator-/ { print $2 }'
    ps -axo command= 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "-port") print $(i + 1) }'
  } | tr '\n' ' ')"
  p="${OPT_PORT:-$PORT_MIN}"
  while [ "$p" -le "$PORT_MAX" ]; do
    if [ $((p % 2)) -eq 0 ] && ! port_in_use "$p"; then
      lock="$STATE_DIR/port-$p.lock"
      if mkdir "$lock" 2>/dev/null; then echo $$ > "$lock/pid"; PORT_LOCK="$lock"; PICKED_PORT="$p"; return 0; fi
      pid="$(cat "$lock/pid" 2>/dev/null)"
      if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then # stale lock from a dead boot
        rm -rf "$lock" && mkdir "$lock" 2>/dev/null && { echo $$ > "$lock/pid"; PORT_LOCK="$lock"; PICKED_PORT="$p"; return 0; }
      fi
    fi
    [ -n "$OPT_PORT" ] && die "console port $OPT_PORT (or $((OPT_PORT + 1))) is in use or odd"
    p=$((p + 1))
  done
  die "no free console port in $PORT_MIN-$PORT_MAX"
}

release_port_lock() { [ -n "${PORT_LOCK:-}" ] && rm -rf "$PORT_LOCK"; PORT_LOCK=""; }

wait_pids_gone() { # timeout-seconds pids...
  local t="$1" i=0 alive p
  shift
  while [ "$i" -lt $((t * 2)) ]; do
    alive=0
    for p in "$@"; do kill -0 "$p" 2>/dev/null && alive=1; done
    [ "$alive" = 0 ] && return 0
    sleep 0.5; i=$((i + 1))
  done
  return 1
}

json_str() { printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"; }

# ---------------------------------------------------------------- commands

cmd_help() {
  cat <<'EOF'
avdslim clones Android emulators (AVDs) copy-on-write so agents can run many
identical, isolated emulators on one Mac: clone a "golden" AVD per task, boot it,
use it, delete it. The Android counterpart of simslim for iOS.

USAGE
  avdslim <command> [args] [options]

COMMANDS
  list                      List AVDs: name, state, serial, kind, target, device
      --booted              Only running AVDs
  status <name>             Show one AVD: state, serial, kind, source, size, config
  clone <src> <name>        Copy-on-write clone of a stopped AVD (APFS clonefile).
                            <name> is sanitized (spaces become '-', other odd
                            characters '_'); the final name is printed. The clone
                            is marked as avdslim-managed and is never golden.
  boot <name>               Boot detached on a free console port, wait for
                            sys.boot_completed=1, print the serial (emulator-NNNN)
                            on stdout. Idempotent: an already running AVD just
                            prints its serial.
      --window              Show the emulator window (default: headless)
      --cold                Cold boot; ignore the saved quickboot snapshot
      --port N              Console port, even, 5554-5584 (default: first free)
      --timeout S           Boot wait limit in seconds (default 180)
      --no-animations       Turn off system animations after boot. Off by default
                            because it changes the motion you may be testing
      --golden              Needed to boot a golden AVD (refresh only)
  serial <name>             Print the serial of a running AVD; exit 1 if stopped
  shutdown <name>           Stop a running AVD (adb emu kill) and wait for exit
  delete <name>...          Permanently delete AVDs (stopped, avdslim-managed)
      --stop                Shut a running AVD down first
      --force               Also delete an AVD avdslim did not create
      --golden              Needed to delete a golden AVD
  rename <old> <new>        Rename a stopped AVD (keeps its markers)
  install <name> <apk>...   adb install -r onto a running AVD; several apks are
                            installed as one split-APK app (install-multiple)
      --golden              Needed to install onto a golden AVD
  golden <name>             Mark an AVD golden (clone source, protected)
  golden <name> --off       Remove the golden mark
  slim <name>               Persist modest config tweaks on a stopped AVD: audio
                            off, no device frame; camera, sensors, GPS and
                            network are left alone
      --ram MB              Also set hw.ramSize
      --cores N             Also set hw.cpu.ncore
      --golden              Needed to slim a golden AVD
  version                   Print the version

GLOBAL OPTIONS
  --json                    Machine-readable output (list, status, clone, boot,
                            shutdown, delete, golden)
  -n, --dry-run             Print what would change; modify nothing
  -h, --help                This help

OUTPUT AND EXIT CODES
  Results go to stdout (boot prints only the serial); progress and warnings go to
  stderr. Exit 0 ok, 1 failure, 2 usage error, 3 refused by a safety rule.

SAFETY RULES
  * A running AVD is never cloned, renamed, slimmed or deleted.
  * A golden AVD cannot be booted, deleted, renamed, slimmed or installed onto
    without --golden. Mark one with `avdslim golden <name>`.
  * `delete` only removes AVDs created by `avdslim clone` unless --force is given,
    and only a directory named <name>.avd directly inside the AVD home.

TYPICAL WORKFLOW
  avdslim clone Ailo_Golden_API34 SUBS-421-renter     # ~0.1s, ~0 disk
  SERIAL=$(avdslim boot SUBS-421-renter)              # prints emulator-5554
  adb -s "$SERIAL" install -r app.apk                 # or: avdslim install ...
  agent-device open app.ailo --serial "$SERIAL" --session subs-421
  avdslim delete SUBS-421-renter --stop               # when the task is done

ENVIRONMENT
  ANDROID_SDK_ROOT / ANDROID_HOME   SDK location (default ~/Library/Android/sdk)
  ANDROID_AVD_HOME                  AVD directory (default ~/.android/avd)
  AVDSLIM_STATE                     Logs and port locks (default ~/.local/state/avdslim)

Boot logs: $AVDSLIM_STATE/logs/<name>.log
EOF
}

cmd_version() { echo "avdslim $AVDSLIM_VERSION"; }

# --- list / status

avd_row() { # name -> prints tab separated: name state serial kind target device
  local name="$1" dir state="stopped" serial="-"
  AVD_INI="$AVD_HOME/$name.ini"
  dir="$(ini_get "$AVD_INI" path)"
  [ -n "$dir" ] || dir="$AVD_HOME/$name.avd"
  [ -f "$dir/config.ini" ] || return 1
  if find_running "$name"; then
    state="running"
    [ -n "$R_PORT" ] && serial="emulator-$R_PORT"
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$state" "$serial" "$(kind_of "$dir")" \
    "$(ini_get "$AVD_INI" target)" "$(ini_get "$dir/config.ini" hw.device.name)"
}

cmd_list() {
  local f name rows="" row
  ps_snapshot
  for f in "$AVD_HOME"/*.ini; do
    [ -f "$f" ] || continue
    name="$(basename "$f" .ini)"
    row="$(avd_row "$name")" || continue
    if [ "$BOOTED_ONLY" = 1 ]; then case "$row" in *$'\trunning\t'*) ;; *) continue ;; esac; fi
    rows="$rows$row"$'\n'
  done
  if [ "$JSON" = 1 ]; then
    local first=1
    printf '['
    while IFS=$'\t' read -r name state serial kind target device; do
      [ -n "$name" ] || continue
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"name":%s,"state":%s,"serial":%s,"kind":%s,"target":%s,"device":%s}' \
        "$(json_str "$name")" "$(json_str "$state")" \
        "$([ "$serial" = "-" ] && echo null || json_str "$serial")" \
        "$(json_str "$kind")" "$(json_str "$target")" "$(json_str "$device")"
    done <<EOF
$rows
EOF
    printf ']\n'
  else
    { printf 'NAME\tSTATE\tSERIAL\tKIND\tTARGET\tDEVICE\n'; printf '%s' "$rows"; } | awk -F'\t' '
      { for (i = 1; i <= NF; i++) { c[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) } n = NR; m = NF }
      END { for (r = 1; r <= n; r++) { line = ""; for (i = 1; i <= m; i++) line = line sprintf("%-" w[i] "s  ", c[r, i]); sub(/ +$/, "", line); print line } }'
  fi
}

cmd_status() {
  [ ${#POS[@]} -eq 1 ] || usage_die "usage: avdslim status <name>"
  local name="${POS[0]}" state="stopped" serial="" pid="" boot="" size ram src created kind target device
  require_avd "$name"
  ps_snapshot
  if find_running "$name"; then
    state="running"; serial="$(serial_of)"; pid="${R_PIDS# }"; pid="${pid%% *}"
    if [ -n "$serial" ]; then
      need_adb
      boot="$("$ADB" -s "$serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')"
    fi
  fi
  kind="$(kind_of "$AVD_DIR")"
  target="$(ini_get "$AVD_INI" target)"
  device="$(ini_get "$AVD_DIR/config.ini" hw.device.name)"
  ram="$(ini_get "$AVD_DIR/config.ini" hw.ramSize)"
  size="$(du -sk "$AVD_DIR" 2>/dev/null | awk '{ print $1 }')"
  src="$(ini_get "$AVD_DIR/avdslim.managed" source)"
  created="$(ini_get "$AVD_DIR/avdslim.managed" created)"
  if [ "$JSON" = 1 ]; then
    printf '{"name":%s,"state":%s,"serial":%s,"pid":%s,"boot_completed":%s,"kind":%s,"source":%s,"created":%s,"target":%s,"device":%s,"ram":%s,"path":%s,"size_kb":%s}\n' \
      "$(json_str "$name")" "$(json_str "$state")" \
      "$([ -n "$serial" ] && json_str "$serial" || echo null)" "${pid:-null}" \
      "$([ "$boot" = 1 ] && echo true || echo false)" "$(json_str "$kind")" \
      "$([ -n "$src" ] && json_str "$src" || echo null)" "$([ -n "$created" ] && json_str "$created" || echo null)" \
      "$(json_str "$target")" "$(json_str "$device")" "$(json_str "$ram")" "$(json_str "$AVD_DIR")" "${size:-0}"
  else
    echo "name:     $name"
    echo "state:    $state${serial:+ ($serial, pid $pid)}"
    [ "$state" = running ] && echo "booted:   $([ "$boot" = 1 ] && echo yes || echo no)"
    echo "kind:     $kind"
    [ -n "$src" ] && echo "source:   $src ($created)"
    echo "target:   $target"
    echo "device:   $device, ram $ram"
    echo "path:     $AVD_DIR"
    echo "size:     $((${size:-0} / 1024)) MB allocated (blocks shared with the source of a clone are counted)"
  fi
}

# --- clone

# Files that belong to one running instance or hold stale identity; never copy them.
strip_instance_state() { # dir
  local d="$1"
  find "$d" \( -name '*.lock' -o -name 'hardware-qemu.ini' -o -name 'emulator-user.ini' \
    -o -name 'bootcompleted.ini' -o -name 'emu-launch-params.txt' -o -name 'read-snapshot.txt' \
    -o -name 'avdslim.golden' -o -name 'avdslim.managed' \) -type f -exec rm -f {} + 2>/dev/null
  rm -rf "$d/tmpAdbCmds"
}

# qcow2 overlays normally name their backing file relatively. The name lives in the
# first cluster, so a header grep finds the rare absolute path into the source AVD
# without spawning qemu-img for every file; only those files get rebased.
fix_backing_files() { # dir srcdir
  local d="$1" s="$2" qi f b fmt
  for f in "$d"/*.qcow2; do
    [ -f "$f" ] || continue
    head -c 4096 "$f" | grep -aqF -- "$s/" || continue
    qi="$(find_tool qemu-img emulator)"
    [ -n "$qi" ] || { warn "qemu-img not found; $(basename "$f") still backs onto the source AVD"; continue; }
    b="$("$qi" info "$f" 2>/dev/null | sed -n 's/^backing file: //p' | awk '{ print $1 }')"
    fmt="$("$qi" info "$f" 2>/dev/null | sed -n 's/^backing file format: //p')"
    case "$b" in
      "$s"/*) "$qi" rebase -u -f qcow2 ${fmt:+-F "$fmt"} -b "${b#"$s"/}" "$f" || warn "could not rebase $f" ;;
    esac
  done
}

write_clone_ini() { # src_ini dst_ini name
  local home_parent
  awk -F= -v p="$AVD_HOME/$3.avd" -v r="avd/$3.avd" '
    $1 == "path" { print "path=" p; next }
    $1 == "path.rel" { print "path.rel=" r; next }
    { print }' "$1" > "$2"
  # path.rel is relative to the AVD home's parent; drop it for a custom layout.
  home_parent="$(dirname "$AVD_HOME")"
  [ "$(basename "$AVD_HOME")" = avd ] && [ -n "$home_parent" ] || sed -i '' '/^path\.rel=/d' "$2"
  grep -q '^path=' "$2" || echo "path=$AVD_HOME/$3.avd" >> "$2"
}

rewrite_identity() { # dir name
  local k
  for k in avd.id avd.name AvdId avd.ini.displayname; do
    if grep -q "^$(printf '%s' "$k" | sed 's/[.]/\\./g')=" "$1/config.ini"; then ini_set "$1/config.ini" "$k" "$2"; fi
  done
}

# A quickboot snapshot is only restored when its recorded hardware config matches the
# AVD's, and that config names the AVD and its image paths. Re-point it at the clone.
patch_snapshots() { # dir srcname name
  local h
  for h in "$1"/snapshots/*/hardware.ini; do
    [ -f "$h" ] || continue
    sed -e "s#/$2\.avd/#/$3.avd/#g" -e "s#^\(avd\.name *= *\)$2\$#\1$3#" -e "s#^\(avd\.id *= *\)$2\$#\1$3#" "$h" > "$h.avdslim" \
      && mv "$h.avdslim" "$h"
  done
}

do_clone_copy() { # srcdir tmpdir
  if ! cp -c -R "$1" "$2" 2>/dev/null; then
    rm -rf "$2"
    warn "copy-on-write clone failed (not APFS?); falling back to a full copy"
    cp -R "$1" "$2" || return 1
  fi
}

cmd_clone() {
  [ ${#POS[@]} -eq 2 ] || usage_die "usage: avdslim clone <src> <name>"
  local src="${POS[0]}" want="${POS[1]}" name tmp t0 t1 src_dir
  name="$(sanitize_name "$want")"
  valid_name "$name" || usage_die "cannot derive a valid AVD name from '$want' (got '$name'; start with a letter or digit, max 64 chars)"
  [ "$name" = "$want" ] || note "name sanitized: '$want' -> '$name'"
  require_avd "$src"
  src_dir="$AVD_DIR"
  local src_ini="$AVD_INI"
  ps_snapshot
  find_running "$src" && refuse "'$src' is running; shut it down before cloning (a live copy would be inconsistent)"
  if [ -e "$AVD_HOME/$name.ini" ] || [ -e "$AVD_HOME/$name.avd" ]; then die "AVD '$name' already exists"; fi
  tmp="$AVD_HOME/.$name.avd.avdslim-tmp"
  [ ! -e "$tmp" ] || die "stale temporary directory $tmp; remove it and retry"
  t0="$(now_ms)"
  if [ "$DRY" = 1 ]; then
    echo "+ cp -c -R $src_dir $AVD_HOME/$name.avd"
    echo "+ write $AVD_HOME/$name.ini, rewrite identity in config.ini, drop per-instance state"
    return 0
  fi
  do_clone_copy "$src_dir" "$tmp" || { rm -rf "$tmp"; die "copy failed"; }
  strip_instance_state "$tmp"
  fix_backing_files "$tmp" "$src_dir"
  rewrite_identity "$tmp" "$name"
  patch_snapshots "$tmp" "$src" "$name"
  printf 'source=%s\ncreated=%s\n' "$src" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp/avdslim.managed"
  write_clone_ini "$src_ini" "$AVD_HOME/$name.ini.avdslim-tmp" "$name"
  mv "$tmp" "$AVD_HOME/$name.avd" || { rm -rf "$tmp"; die "could not move clone into place"; }
  mv "$AVD_HOME/$name.ini.avdslim-tmp" "$AVD_HOME/$name.ini"
  t1="$(now_ms)"
  if [ "$JSON" = 1 ]; then
    printf '{"name":%s,"source":%s,"path":%s,"ms":%s}\n' "$(json_str "$name")" "$(json_str "$src")" "$(json_str "$AVD_HOME/$name.avd")" "$((t1 - t0))"
  else
    echo "cloned $src -> $name ($(fmt_secs $((t1 - t0))))"
  fi
}

# --- boot / serial / shutdown

wait_boot() { # serial pid timeout
  local serial="$1" pid="$2" limit="$3" i=0 v
  while [ "$i" -lt $((limit * 2)) ]; do
    kill -0 "$pid" 2>/dev/null || return 2
    v="$("$ADB" -s "$serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')"
    [ "$v" = 1 ] && return 0
    sleep 0.5; i=$((i + 1))
  done
  return 1
}

detach() { # logfile cmd...
  local log="$1"
  shift
  if command -v perl >/dev/null 2>&1; then
    perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or die "exec: $!"' -- "$@" </dev/null >"$log" 2>&1 &
  else
    nohup "$@" </dev/null >"$log" 2>&1 &
  fi
  LAUNCHED_PID=$!
}

cmd_boot() {
  [ ${#POS[@]} -eq 1 ] || usage_die "usage: avdslim boot <name>"
  local name="${POS[0]}" t0 t1 args log serial rc
  require_avd "$name"
  need_golden_flag "$name" "$AVD_DIR" "booting it"
  ps_snapshot
  if find_running "$name"; then
    serial="$(serial_of)" || die "'$name' is running but its serial could not be determined"
    note "$name already running as $serial"
    emit_boot "$name" "$serial" 0 true
    return 0
  fi
  need_adb; need_emulator
  mkdir -p "$STATE_DIR/logs" || die "cannot create $STATE_DIR/logs"
  log="$STATE_DIR/logs/$name.log"
  pick_port
  trap release_port_lock EXIT
  serial="emulator-$PICKED_PORT"
  args=(-avd "$name" -port "$PICKED_PORT" -no-boot-anim -no-audio -no-metrics)
  [ "$WINDOW" = 1 ] || args+=(-no-window)
  [ "$COLD" = 1 ] && args+=(-no-snapshot-load)
  # Only a golden AVD (refresh) may save its quickboot snapshot; clones start from it every time.
  is_golden "$AVD_DIR" || args+=(-no-snapshot-save)
  if [ "$DRY" = 1 ]; then
    echo "+ $EMULATOR ${args[*]} > $log"
    release_port_lock
    return 0
  fi
  t0="$(now_ms)"
  "$ADB" start-server >/dev/null 2>&1
  detach "$log" "$EMULATOR" "${args[@]}"
  wait_boot "$serial" "$LAUNCHED_PID" "$OPT_TIMEOUT"
  rc=$?
  release_port_lock
  if [ "$rc" -ne 0 ]; then
    [ "$rc" = 2 ] && note "emulator exited during boot; last log lines:" || note "timed out after ${OPT_TIMEOUT}s; leaving it running ($serial); last log lines:"
    tail -n 8 "$log" >&2
    exit 1
  fi
  [ "$NO_ANIM" = 1 ] && disable_animations "$serial"
  t1="$(now_ms)"
  note "$name booted as $serial in $(fmt_secs $((t1 - t0)))"
  emit_boot "$name" "$serial" $((t1 - t0)) false
}

emit_boot() { # name serial ms already
  if [ "$JSON" = 1 ]; then
    printf '{"name":%s,"serial":%s,"ms":%s,"already_running":%s}\n' "$(json_str "$1")" "$(json_str "$2")" "$3" "$4"
  else
    echo "$2"
  fi
}

disable_animations() {
  local s="$1" k
  for k in window_animation_scale transition_animation_scale animator_duration_scale; do
    "$ADB" -s "$s" shell settings put global "$k" 0 >/dev/null 2>&1
  done
}

cmd_serial() {
  [ ${#POS[@]} -eq 1 ] || usage_die "usage: avdslim serial <name>"
  require_avd "${POS[0]}"
  ps_snapshot
  find_running "${POS[0]}" || exit 1
  serial_of || exit 1
}

cmd_shutdown() {
  [ ${#POS[@]} -eq 1 ] || usage_die "usage: avdslim shutdown <name>"
  local name="${POS[0]}"
  require_avd "$name"
  ps_snapshot
  find_running "$name" || { note "$name is not running"; return 0; }
  stop_avd "$name"
}

stop_avd() { # name; expects find_running already filled R_PIDS/R_PORT
  local name="$1" serial t0 t1 limit=30 pids
  serial="$(serial_of)"
  pids="$R_PIDS"
  is_golden "$AVD_DIR" && limit=90 # golden saves its quickboot snapshot on exit
  t0="$(now_ms)"
  if [ "$DRY" = 1 ]; then echo "+ adb -s ${serial:-?} emu kill"; return 0; fi
  need_adb
  if [ -n "$serial" ]; then "$ADB" -s "$serial" emu kill >/dev/null 2>&1; fi
  # shellcheck disable=SC2086
  if ! wait_pids_gone "$limit" $pids; then
    warn "$name did not exit after ${limit}s; sending SIGTERM"
    # shellcheck disable=SC2086
    kill $pids 2>/dev/null
    # shellcheck disable=SC2086
    wait_pids_gone 10 $pids || die "could not stop $name (pids:$pids)"
  fi
  t1="$(now_ms)"
  if [ "$JSON" = 1 ]; then
    printf '{"name":%s,"stopped":true,"ms":%s}\n' "$(json_str "$name")" "$((t1 - t0))"
  else
    echo "stopped $name ($(fmt_secs $((t1 - t0))))"
  fi
}

# --- delete

delete_one() {
  local name="$1" dir
  require_avd "$name"
  dir="$AVD_DIR"
  safe_avd_dir "$name" "$dir" || refuse "'$name' is not a plain <name>.avd directory inside $AVD_HOME; delete it with avdmanager"
  if is_golden "$dir"; then
    [ "$GOLDEN_OK" = 1 ] || refuse "'$name' is a golden AVD; deleting needs --golden"
  elif ! is_managed "$dir" && [ "$FORCE" != 1 ]; then
    refuse "'$name' was not created by avdslim; add --force to delete it anyway"
  fi
  ps_snapshot
  if find_running "$name"; then
    # --force never overrides this: a running AVD that avdslim did not create may be in use.
    is_managed "$dir" || is_golden "$dir" || refuse "'$name' is running and was not created by avdslim; stop it yourself first"
    [ "$STOP" = 1 ] || refuse "'$name' is running; shut it down first or pass --stop"
    stop_avd "$name" || exit 1
  fi
  if [ "$DRY" = 1 ]; then
    echo "+ rm -rf $dir"
    echo "+ rm -f $AVD_HOME/$name.ini"
    return 0
  fi
  rm -rf -- "$dir" || die "could not remove $dir"
  rm -f -- "$AVD_HOME/$name.ini"
  rm -f -- "$STATE_DIR/logs/$name.log"
  if [ "$JSON" = 1 ]; then printf '{"name":%s,"deleted":true}\n' "$(json_str "$name")"; else echo "deleted $name"; fi
}

cmd_delete() {
  [ ${#POS[@]} -ge 1 ] || usage_die "usage: avdslim delete <name>..."
  local n
  for n in "${POS[@]}"; do delete_one "$n"; done
}

# --- rename

cmd_rename() {
  [ ${#POS[@]} -eq 2 ] || usage_die "usage: avdslim rename <old> <new>"
  local old="${POS[0]}" new
  new="$(sanitize_name "${POS[1]}")"
  valid_name "$new" || usage_die "invalid new name '${POS[1]}'"
  require_avd "$old"
  safe_avd_dir "$old" "$AVD_DIR" || refuse "'$old' is not a plain <name>.avd directory inside $AVD_HOME"
  need_golden_flag "$old" "$AVD_DIR" "renaming it"
  ps_snapshot
  find_running "$old" && refuse "'$old' is running; shut it down first"
  if [ -e "$AVD_HOME/$new.ini" ] || [ -e "$AVD_HOME/$new.avd" ]; then die "AVD '$new' already exists"; fi
  if [ "$DRY" = 1 ]; then echo "+ mv $old.avd $new.avd; write $new.ini"; return 0; fi
  mv "$AVD_DIR" "$AVD_HOME/$new.avd" || die "move failed"
  write_clone_ini "$AVD_INI" "$AVD_HOME/$new.ini" "$new"
  rm -f "$AVD_INI"
  rewrite_identity "$AVD_HOME/$new.avd" "$new"
  echo "renamed $old -> $new"
}

# --- install

cmd_install() {
  [ ${#POS[@]} -ge 2 ] || usage_die "usage: avdslim install <name> <apk>..."
  local name="${POS[0]}" serial apks=() i
  for ((i = 1; i < ${#POS[@]}; i++)); do
    [ -f "${POS[$i]}" ] || die "no such file: ${POS[$i]}"
    apks+=("${POS[$i]}")
  done
  require_avd "$name"
  need_golden_flag "$name" "$AVD_DIR" "installing onto it"
  ps_snapshot
  find_running "$name" || die "'$name' is not running (avdslim boot $name)"
  serial="$(serial_of)" || die "cannot determine serial for '$name'"
  need_adb
  if [ ${#apks[@]} -eq 1 ]; then
    act "$ADB" -s "$serial" install -r -d "${apks[0]}"
  else
    act "$ADB" -s "$serial" install-multiple -r -d "${apks[@]}"
  fi
}

# --- golden / slim

cmd_golden() {
  [ ${#POS[@]} -eq 1 ] || usage_die "usage: avdslim golden <name> [--off]"
  local name="${POS[0]}"
  require_avd "$name"
  safe_avd_dir "$name" "$AVD_DIR" || refuse "'$name' is not a plain <name>.avd directory inside $AVD_HOME"
  if [ "$OFF" = 1 ]; then
    act rm -f "$AVD_DIR/avdslim.golden"
    [ "$DRY" = 1 ] || echo "$name is no longer golden"
  else
    ps_snapshot
    find_running "$name" && refuse "'$name' is running; shut it down before marking it golden"
    if [ "$DRY" = 1 ]; then echo "+ touch $AVD_DIR/avdslim.golden"; return 0; fi
    printf 'marked=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$AVD_DIR/avdslim.golden"
    echo "$name is now golden"
  fi
}

cmd_slim() {
  [ ${#POS[@]} -eq 1 ] || usage_die "usage: avdslim slim <name> [--ram MB] [--cores N]"
  local name="${POS[0]}" cfg
  require_avd "$name"
  need_golden_flag "$name" "$AVD_DIR" "slimming it"
  ps_snapshot
  find_running "$name" && refuse "'$name' is running; shut it down first"
  cfg="$AVD_DIR/config.ini"
  if [ "$DRY" = 1 ]; then
    echo "+ config.ini: hw.audioInput=no hw.audioOutput=no showDeviceFrame=no${OPT_RAM:+ hw.ramSize=${OPT_RAM}M}${OPT_CORES:+ hw.cpu.ncore=$OPT_CORES}"
    return 0
  fi
  ini_set "$cfg" hw.audioInput no
  ini_set "$cfg" hw.audioOutput no
  ini_set "$cfg" showDeviceFrame no
  [ -z "$OPT_RAM" ] || ini_set "$cfg" hw.ramSize "${OPT_RAM}M"
  [ -z "$OPT_CORES" ] || ini_set "$cfg" hw.cpu.ncore "$OPT_CORES"
  echo "slimmed $name"
}

# ---------------------------------------------------------------- main

OFF=0
main() {
  [ $# -gt 0 ] || { cmd_help; exit 2; }
  local cmd="$1"
  shift
  case "$cmd" in help|-h|--help) cmd_help; exit 0 ;; esac
  # `--off` belongs to `golden` only.
  local a rest=()
  for a in "$@"; do if [ "$a" = "--off" ]; then OFF=1; else rest+=("$a"); fi; done
  [ "$OFF" = 0 ] || [ "$cmd" = golden ] || usage_die "--off only applies to 'golden'"
  parse_args ${rest[@]+"${rest[@]}"}
  [ -d "$AVD_HOME" ] || die "AVD home not found: $AVD_HOME (set ANDROID_AVD_HOME)"
  case "$cmd" in
    list|ls) cmd_list ;;
    status) cmd_status ;;
    clone) cmd_clone ;;
    boot) cmd_boot ;;
    serial) cmd_serial ;;
    shutdown|stop) cmd_shutdown ;;
    delete|rm) cmd_delete ;;
    rename) cmd_rename ;;
    install) cmd_install ;;
    golden) cmd_golden ;;
    slim) cmd_slim ;;
    version|--version) cmd_version ;;
    *) usage_die "unknown command: $cmd" ;;
  esac
}

main "$@"
